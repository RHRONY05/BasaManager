{
  "name": "@bm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config/*": "./src/config/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./modules/*": "./src/modules/*.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "e2e:seed": "tsx prisma/e2e-seed.ts"
  },
  "dependencies": {
    "@bm/domain": "workspace:*",
    "@bm/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.11.0",
    "@socket.io/redis-adapter": "8.3.0",
    "arctic": "3.7.0",
    "argon2": "0.45.2",
    "cloudinary": "2.5.1",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "multer": "1.4.5-lts.1",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "rate-limit-redis": "6.0.2",
    "socket.io": "4.8.4",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "1.4.12",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2"
  }
}
