# Copy to .env (never commit .env). Dev values below are safe local-only defaults.
# Empty values = a human or generated secret; see .agent/CREDENTIALS-GUIDE.md.
# ── core ───────────────────────────────────────────────
NODE_ENV=development
APP_ENV=dev
APP_URL=http://localhost:5173
PORT=4000
LOG_LEVEL=info
# ── database (dev-only passwords, see infra/postgres/init/01-roles.sql) ──
DATABASE_URL=postgresql://bm_app:bm_app_dev@localhost:5432/basamanager_dev
DATABASE_OWNER_URL=postgresql://bm_owner:bm_owner_dev@localhost:5432/basamanager_dev
DATABASE_WORKER_URL=postgresql://bm_worker:bm_worker_dev@localhost:5432/basamanager_dev
REDIS_URL=redis://:redis_dev@localhost:6379/0
# ── auth ───────────────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# ── file storage ───────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
STORAGE_URL_SECRET=
STORAGE_FOLDER=basamanager/dev
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ── backups (VM + CI only) ─────────────────────────────
AZURE_BACKUP_ACCOUNT=
AZURE_BACKUP_SAS=
# ── email ──────────────────────────────────────────────
SMTP_URL=smtp://localhost:1025
MAIL_FROM="BasaManager <no-reply@notify.basamanager.rhrony05.me>"
# ── web push ───────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:muhammadrony147@gmail.com
# ── payments ───────────────────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
PAYMENTS_MOCK=false
# ── observability ──────────────────────────────────────
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
SENTRY_DSN_WEB=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
# ── seed & test only ───────────────────────────────────
SEED_PASSWORD=
E2E_PASSWORD=
CLOCK_OVERRIDE=
