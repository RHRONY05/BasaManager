{
  "name": "basamanager",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "docker compose -f infra/compose.dev.yml up -d && concurrently -n api,worker,web -c blue,magenta,green \"pnpm --filter @bm/api dev\" \"pnpm --filter @bm/worker dev\" \"pnpm --filter @bm/web dev\"",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . && prettier --check . && node scripts/lint-tokens.mjs && pnpm --filter @bm/web size && pnpm openapi:check",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run -c vitest.int.config.ts",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/smoke.js",
    "docs:check": "pnpm --filter @bm/docs build && node scripts/docs-check.mjs",
    "test:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:int && pnpm test:e2e && pnpm docs:check",
    "db:migrate": "pnpm --filter @bm/api db:migrate",
    "db:seed": "pnpm --filter @bm/api db:seed",
    "e2e:seed": "pnpm --filter @bm/api e2e:seed",
    "db:docs": "node scripts/db-docs.mjs",
    "openapi": "node scripts/openapi.mjs",
    "openapi:check": "node scripts/openapi.mjs --check"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
